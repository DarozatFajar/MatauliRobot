# Arduino .gitignore

# Compiled object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Arduino IDE specific files
*.tmp
*.tmp.*
*.d
*.elf
*.bin
*.hex
*.bin.*
*.elf.*
*.hex.*
*.map
*.sym
*.lss
*.eep
*.srec
*.mot

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
